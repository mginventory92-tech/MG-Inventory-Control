# انسخ الملف باسم .env وعدّل القيم
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inventory
PORT=3000
# مفتاح تشفير الجلسات: اكتب أي نص طويل عشوائي (مهم جداً تغييره)
JWT_SECRET=غيّر-هذا-النص-إلى-شيء-طويل-وعشوائي
# بيانات أول مستخدم (مدير). بتتكوّن مرة واحدة فقط لو مفيش مستخدمين.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=غيّر-كلمة-المرور
# عناوين الويب المسموح لها بالاتصال بالـ API (مفصولة بفاصلة). اتركه فارغ للسماح للجميع أثناء التطوير.
CORS_ORIGIN=
# true = السيرفر يبني/يحدّث جداول قاعدة البيانات تلقائياً. اجعله false بعد ما تستقر على الشكل النهائي.
DB_SYNC=true
